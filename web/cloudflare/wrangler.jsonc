//
// A Cloudflare Pages project serving the HTML book with its in-browser
// exercise editor.  `build.sh` assembles `dist/`; deploy with
//   CLOUDFLARE_ACCOUNT_ID=<account> npx wrangler pages deploy --branch main
// from this directory.
{
  "name": "sf-lean",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-01",

  // The bucket holding Lean's WebAssembly binary, under `<version>/lean.wasm`
  // (the lean4-wasm-in-browser deployment's layout).  Only
  // functions/lean/[[path]].js reads it.
  "r2_buckets": [
    { "binding": "LEAN_ASSETS", "bucket_name": "lean-assets" }
  ]
}
